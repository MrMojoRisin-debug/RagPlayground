# Copy to .env and fill in.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
RAG_LLM_MODEL=anthropic/claude-sonnet-5.5
RAG_JUDGE_MODEL=anthropic/claude-sonnet-5.5
RAG_TEMPERATURE=0.1

# --- System prompt (any file in prompts/) ---
RAG_SYSTEM_PROMPT=prompts/system.md
# Exact phrase the prompt tells the model to use when the corpus lacks the answer.
# The refusal evaluator looks for it, so keep the two in sync.
RAG_REFUSAL_TEXT=I couldn't find that in the corpus.

# --- Retrieval / ingestion ---
RAG_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_CHUNK_SIZE=3200
RAG_CHUNK_OVERLAP=400
RAG_TOP_K=6
RAG_HISTORY_TURNS=3

# --- Reranker (TypeSafe AI Jev) ---
# none = embedding order only; jev = fetch RAG_RERANK_CANDIDATES chunks, let Jev pick the best RAG_TOP_K
RAG_RERANKER=none
RAG_RERANK_CANDIDATES=20
TYPESAFE_API_KEY=
# Pin an exact version (e.g. jev-1.13.0) once you've compared runs, so an alias update can't shift results
RAG_JEV_MODEL=jev-latest
RAG_JEV_TIMEOUT=10

# --- LangSmith (evals + tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=rag-playground
LANGSMITH_DATASET=rag-playground-eval
