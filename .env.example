# Copy to .env and fill in.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
RAG_LLM_MODEL=anthropic/claude-sonnet-5.5
RAG_JUDGE_MODEL=anthropic/claude-sonnet-5.5
RAG_TEMPERATURE=0.1

# --- System prompt (any file in prompts/) ---
RAG_SYSTEM_PROMPT=prompts/system.md
# Exact phrase the prompt tells the model to use when the corpus lacks the answer.
# The refusal evaluator looks for it, so keep the two in sync.
RAG_REFUSAL_TEXT=I couldn't find that in the corpus.

# --- Retrieval / ingestion ---
RAG_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_CHUNK_SIZE=3200
RAG_CHUNK_OVERLAP=400
RAG_TOP_K=6
RAG_HISTORY_TURNS=3

# --- LangSmith (evals + tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=rag-playground
LANGSMITH_DATASET=rag-playground-eval
